{
  "name": "flow-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "支持 m3u / m3u8 播放列表的在线音视频播放网站",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "test": "node scripts/test-m3u.mjs",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "video.js": "^8.17.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "vite": "^6.3.5"
  }
}
